# GitHub Projects read/write plus eniveil issue write access for triage.
# Never paste actual credentials into Git or chat.
PROJECTS_GITHUB_TOKEN=
# Only required when the Qwen Aider worker is enabled; limit to eniveil contents and pull requests.
PASEO_QWEN_GITHUB_TOKEN=
# LFM3 triage endpoint on the Ollama host.
OLLAMA_URL=http://127.0.0.1:11434
# Organization key scoped to runs:dispatch. Used by daemon execution only.
PASEO_ROUTER_API_KEY=

# Claude account routine trigger token; not a paid Platform model API key.
PASEO_CLAUDE_ROUTINE_TOKEN=
