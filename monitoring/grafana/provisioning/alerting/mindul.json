{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Mindul operations",
      "folder": "Mindul Operations",
      "interval": "1m",
      "rules": [
        {
          "uid": "mindul-disk-warning",
          "title": "Disk usage > 85%",
          "condition": "B",
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Alerting",
          "labels": {
            "severity": "warning",
            "managed_by": "mindul"
          },
          "annotations": {
            "summary": "Disk usage > 85%",
            "runbook_url": "https://github.com/MindulMendul/mindul-ai-infra/blob/main/ops/README.md"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A > 85",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
