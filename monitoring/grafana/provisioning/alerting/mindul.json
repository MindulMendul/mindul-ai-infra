              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "((mindul_tls_certificate_expiry_timestamp_seconds - time()) / 86400) and (mindul_tls_certificate_expiry_timestamp_seconds > 0)",
