              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "math",
                "expression": "$A < 14",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            }
          ]
        },
