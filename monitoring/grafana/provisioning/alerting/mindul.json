        {
          "uid": "mindul-tls-expiring",
          "title": "TLS certificate expires within 14 days",
          "condition": "B",
          "for": "1h",
          "noDataState": "OK",
          "execErrState": "Alerting",
          "labels": {
            "severity": "warning",
            "managed_by": "mindul"
          },
          "annotations": {
            "summary": "TLS certificate expires within 14 days",
            "runbook_url": "https://github.com/MindulMendul/mindul-ai-infra/blob/main/ops/README.md"
          },
          "data": [
            {
              "refId": "A",
