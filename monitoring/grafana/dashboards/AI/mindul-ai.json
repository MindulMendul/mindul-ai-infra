{
  "uid": "mindul-ai",
  "title": "Mindul \u00b7 Ollama AI",
  "tags": [
    "mindul"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active AI requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_requests_active",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Loaded model memory",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_model_memory_bytes",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Chat requests per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (model,status) (rate(mindul_ai_requests_total[$__rate_interval]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "End-to-end latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,model) (rate(mindul_ai_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Input / output tokens per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (model,direction) (rate(mindul_ai_tokens_total[$__rate_interval]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "\uc0dd\uc131 \uc18d\ub3c4 \ucd94\uc774 \u00b7 tokens/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(mindul_ai_tokens_total{direction=\"output\"}[$__rate_interval])) / sum by (model) (rate(mindul_ai_generation_seconds_total[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "\uc751\ub2f5\uc744 \uc0dd\uc131\ud55c \uc2dc\uac04 \uae30\uc900\uc785\ub2c8\ub2e4. \ubaa8\ub378 \ub85c\ub529\uacfc \uc785\ub825 \ucc98\ub9ac \uc2dc\uac04\uc740 \uc81c\uc678\ud569\ub2c8\ub2e4. \uc751\ub2f5 \uc644\ub8cc \ud6c4 \ucd5c\uc885 \ud1a0\ud070 \uc218\ub85c \uacc4\uc0b0\ud569\ub2c8\ub2e4."
    },
    {
      "id": 7,
      "title": "Model loading time accumulated",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(mindul_ai_load_seconds_total[$__range]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Failed / cancelled / incomplete requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model,status) (increase(mindul_ai_requests_total{status!=\"200\"}[$__range]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "\ub9c8\uc9c0\ub9c9 \uc751\ub2f5 \uc0dd\uc131 \uc18d\ub3c4",
      "description": "\ucd9c\ub825 \ud1a0\ud070 \uc218 \u00f7 \uc21c\uc218 \uc0dd\uc131 \uc2dc\uac04. \uc751\ub2f5 \uc644\ub8cc \ud6c4 \uac31\uc2e0\ub418\uba70 \ub2e4\uc74c \uc751\ub2f5\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \ub9c8\uc9c0\ub9c9 \uce21\uc815\uac12\uc744 \ud45c\uc2dc\ud569\ub2c8\ub2e4.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_last_generation_tokens_per_second",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "title": "\ucd5c\uadfc 5\ubd84 \ud3c9\uade0 \uc0dd\uc131 \uc18d\ub3c4",
      "description": "\ucd5c\uadfc 5\ubd84\uc758 \ucd9c\ub825 \ud1a0\ud070 \ud569\uacc4 \u00f7 \uc0dd\uc131 \uc2dc\uac04 \ud569\uacc4. \uc694\uccad\uc774 \uc5c6\uc73c\uba74 \uac12\uc774 \ud45c\uc2dc\ub418\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(mindul_ai_tokens_total{direction=\"output\"}[5m])) / sum by (model) (rate(mindul_ai_generation_seconds_total[5m]))",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 11,
      "title": "\ub9c8\uc9c0\ub9c9 \uc751\ub2f5 \uc804\uccb4 \ucc98\ub9ac \uc18d\ub3c4",
      "description": "\ucd9c\ub825 \ud1a0\ud070 \uc218 \u00f7 \uc804\uccb4 Ollama \ucc98\ub9ac \uc2dc\uac04. \ubaa8\ub378 \ub85c\ub529\uacfc \uc785\ub825 \ucc98\ub9ac \uc2dc\uac04\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_last_total_tokens_per_second",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "\ub9c8\uc9c0\ub9c9 \uc751\ub2f5 \uc644\ub8cc \uc2dc\uac01",
      "description": "\ub9c8\uc9c0\ub9c9 \uc18d\ub3c4 \uce21\uc815\uc774 \uc5b8\uc81c \uc644\ub8cc\ub410\ub294\uc9c0 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_last_response_timestamp_seconds * 1000",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
