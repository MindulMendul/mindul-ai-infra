{
  "uid": "mindul-ai",
  "title": "Mindul · Ollama AI",
  "tags": [
    "mindul"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active AI requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_requests_active",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Loaded model memory",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_model_memory_bytes",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Chat requests per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (model,status) (rate(mindul_ai_requests_total[$__rate_interval]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "End-to-end latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,model) (rate(mindul_ai_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Input / output tokens per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (model,direction) (rate(mindul_ai_tokens_total[$__rate_interval]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "생성 속도 추이 · tokens/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(mindul_ai_tokens_total{direction=\"output\"}[$__rate_interval])) / sum by (model) (rate(mindul_ai_generation_seconds_total[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": "응답을 생성한 시간 기준입니다. 모델 로딩과 입력 처리 시간은 제외합니다. 응답 완료 후 최종 토큰 수로 계산합니다."
    },
    {
      "id": 7,
      "title": "Model loading time accumulated",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(mindul_ai_load_seconds_total[$__range]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Failed / cancelled / incomplete requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model,status) (increase(mindul_ai_requests_total{status!=\"200\"}[$__range]))",
          "legendFormat": "{{model}} {{direction}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "마지막 응답 생성 속도",
      "description": "출력 토큰 수 ÷ 순수 생성 시간. 응답 완료 후 갱신되며 다음 응답이 끝날 때까지 마지막 측정값을 표시합니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_last_generation_tokens_per_second",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "title": "최근 5분 평균 생성 속도",
      "description": "최근 5분의 출력 토큰 합계 ÷ 생성 시간 합계. 요청이 없으면 값이 표시되지 않을 수 있습니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(mindul_ai_tokens_total{direction=\"output\"}[5m])) / sum by (model) (rate(mindul_ai_generation_seconds_total[5m]))",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 11,
      "title": "마지막 응답 전체 처리 속도",
      "description": "출력 토큰 수 ÷ 전체 Ollama 처리 시간. 모델 로딩과 입력 처리 시간을 포함합니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_last_total_tokens_per_second",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tokens/s",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "마지막 응답 완료 시각",
      "description": "마지막 속도 측정이 언제 완료됐는지 확인할 수 있습니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mindul_ai_last_response_timestamp_seconds * 1000",
          "instant": true,
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ],
  "links": [
    {
      "title": "Infrastructure",
      "url": "/grafana/d/mindul-infra"
    },
    {
      "title": "Web RUM",
      "url": "/grafana/d/mindul-rum"
    },
    {
      "title": "AI",
      "url": "/grafana/d/mindul-ai"
    },
    {
      "title": "Operations",
      "url": "/grafana/d/mindul-ops"
    }
  ]
}
