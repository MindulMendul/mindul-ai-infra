faro.receiver "production" {
  log_format = "json"
  extra_log_labels = { environment = "production", service_name = "murder-parker-web" }
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    max_allowed_payload_size = "256KiB"
  }
  output {
    logs = [loki.write.local.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}
faro.receiver "qa" {
  log_format = "json"
  extra_log_labels = { environment = "qa", service_name = "murder-parker-web" }
  server {
    listen_address = "0.0.0.0"
    listen_port = 12348
    max_allowed_payload_size = "256KiB"
  }
  output {
    logs = [loki.write.local.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}
